# ---------- Marca (producto revendible: cambia estos valores por cliente) ----------
# Empresa dueña del cuarto (aparece arriba en el ingreso). Vacío = "Empresa de demostración".
NEXT_PUBLIC_ORG_NAME=""
NEXT_PUBLIC_ROOM_NAME="Cuarto de datos"
APP_TIMEZONE="America/Bogota"

# ---------- Recepción BONNY (código de 6 dígitos del cuarto) ----------
# La recepción es otra instalación (otro proyecto de Vercel) del mismo repositorio con APP_MODE=recepcion.
# En la RECEPCIÓN: lista de cuartos, cada uno con su código, su dirección y un secreto compartido (32+ caracteres):
#   RECEPTION_ROOMS=[{"codigo":"482731","url":"https://harbor.bonnyanalytics.com","secreto":"..."}]
APP_MODE=""
RECEPTION_ROOMS=""
# En cada CUARTO: el mismo secreto que tiene en la recepción y la dirección de la recepción.
# Si faltan, el cuarto funciona como siempre (se entra directo a /login).
RECEPTION_SECRET=""
RECEPTION_URL=""

# ---------- Marca del cliente dentro del cuarto (opcional; vacío = aspecto de siempre) ----------
# La pantalla de ingreso siempre lleva la identidad de BONNY; esto cambia el interior del cuarto.
# Colores en formato #rrggbb. ACCENT se usa sobre fondos oscuros (barra superior);
# ACCENT_ON_LIGHT sobre fondos claros (textos, bordes y foco): debe contrastar con el blanco.
BRAND_COLOR_PRIMARY=""
BRAND_COLOR_ACCENT=""
BRAND_COLOR_ACCENT_ON_LIGHT=""
# Tipografía del cliente: vacío (Montserrat y Cormorant, las de siempre) o "poppins".
BRAND_FONT=""
# Logos dentro de public/marcas/ (svg, png o webp). Uno para fondo claro y otro para fondo oscuro.
BRAND_LOGO=""
BRAND_LOGO_ON_DARK=""
# Ejemplo Harbor Shipping:
#   NEXT_PUBLIC_ORG_NAME="Harbor Shipping"  BRAND_COLOR_PRIMARY="#1e1e59"  BRAND_COLOR_ACCENT="#b6ff00"
#   BRAND_COLOR_ACCENT_ON_LIGHT="#7036ff"  BRAND_FONT="poppins"
#   BRAND_LOGO="/marcas/harbor-shipping.svg"  BRAND_LOGO_ON_DARK="/marcas/harbor-shipping-negativo.svg"

# ---------- Supabase (Project Settings → API). Solo servidor: nunca NEXT_PUBLIC ----------
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------- Sesión ----------
# Cadena aleatoria de 32+ caracteres:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
IDLE_TIMEOUT_MINUTES=15
REQUIRE_MFA=true

# ---------- Documentos ----------
# drive = Google Drive con cuenta de servicio; local = carpeta del disco (solo desarrollo/demos)
DOCS_SOURCE=drive
DRIVE_ROOT_FOLDER_ID=""
# Contenido completo del archivo JSON de la cuenta de servicio (pegado tal cual, empieza por "{").
GOOGLE_SERVICE_ACCOUNT_JSON=""
LOCAL_DOCS_DIR="./demo-docs"

# ---------- Geolocalización ----------
# Si no hay cabeceras de Vercel, consultar ipapi.co (gratis, 1000 consultas/día). off para desactivar.
GEO_FALLBACK=ipapi

# ---------- Protección de pantalla ----------
# Escudo anticaptura: solo se ve nítida la franja bajo el cursor. "false" para desactivarlo.
SCREEN_SHIELD=true

# ---------- Tarea diaria (mantiene activo Supabase gratuito) ----------
# Opcional: si se define, Vercel la envía sola y la ruta /api/cron/keepalive la exige.
CRON_SECRET=""

# ---------- Datos legales (Política de tratamiento de datos, Ley 1581 de 2012) ----------
# Responsable del tratamiento = la empresa cliente dueña de los documentos.
# Si faltan, la política los muestra como "Pendiente de completar".
LEGAL_RESPONSIBLE_NAME=""
LEGAL_RESPONSIBLE_ID=""
LEGAL_RESPONSIBLE_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_CONTACT_PHONE=""
# Encargado del tratamiento (quien implementa y da soporte)
LEGAL_PROCESSOR_NAME="BONNY Analytics"
